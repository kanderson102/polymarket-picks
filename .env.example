# ============================================================
# Polymarket Copy-Bot — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# ------ Wallet (Required for live balance display) ----------
# Your dedicated bot wallet's PUBLIC address on Polygon
BOT_WALLET_ADDRESS=0xYOUR_BOT_WALLET_PUBLIC_ADDRESS

# Alchemy (or QuickNode) RPC URL for querying on-chain USDC balance
ALCHEMY_POLYGON_URL=https://polygon-mainnet.g.alchemy.com/v2/YOUR_KEY

# ------ Wallet (Required for live CLOB execution) -----------
# Your dedicated bot wallet's PRIVATE key — use a SEPARATE wallet, not your main one
BOT_PRIVATE_KEY=0xYOUR_BOT_WALLET_PRIVATE_KEY

# Your personal wallet where harvested profits are sent
HARVEST_WALLET_ADDRESS=0xYOUR_PERSONAL_WALLET_ADDRESS

# ------ Polymarket CLOB API (Required for No-Bot live execution) ------------
# Get these from polymarket.com → Settings → API after connecting your wallet.
# L2 (off-chain) credentials — do NOT confuse with your wallet private key.
CLOB_API_KEY=
CLOB_API_SECRET=
CLOB_API_PASSPHRASE=

# ------ No-Bot execution mode ------------------------------------
# NO_BOT_DRY_RUN=true   → logs what would be submitted, no real orders (safe default)
# NO_BOT_DRY_RUN=false  → submits real CLOB orders (requires CLOB credentials above)
# Also set nb_live_mode=1 from Settings → No-Bot in the dashboard.
NO_BOT_DRY_RUN=true

# ------ Telegram (Optional) ---------------------------------
# Create a bot via @BotFather, get the token and your chat ID
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Set to "false" to silence all Telegram alerts without touching the database
ENABLE_TELEGRAM=true
